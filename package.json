{
  "name": "suivi-tuktuk",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Suivi Tuk-tuk & Cyclo Vitafoam : partenaires conducteurs, fiches de suivi, commissions, paiements, intégration Odoo (React, Express, MySQL)",
  "scripts": {
    "dev:frontend": "vite --config frontend/vite.config.js",
    "dev:backend": "node --watch backend/server.js",
    "dev": "npm run dev:backend & npm run dev:frontend",
    "build": "vite build --config frontend/vite.config.js",
    "start": "node backend/server.js",
    "db:init": "node backend/scripts/init-db.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "bcryptjs": "^2.4.3",
    "bootstrap-icons": "^1.13.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^6.9.16",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
